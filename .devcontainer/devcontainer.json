{
  "name": "Platinum Axe Dev",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-docker",
        "github.copilot",
        "yzhang.markdown-all-in-one",
        "bierner.markdown-mermaid",
        "bierner.markdown-preview-github-styles"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspace/backend/.venv/bin/python",
        "python.analysis.extraPaths": [
          "/workspace/backend"
        ],
        "python.terminal.activateEnvironment": true,
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests"
        ],
        "python.testing.cwd": "/workspace/backend",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        },
        "ruff.nativeServer": true,
        "ruff.configurationPreference": "filesystemFirst",
        "ruff.configuration": "/workspace/backend/pyproject.toml",
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },
        "[typescriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        }
      }
    }
  },
  "postCreateCommand": "cd /workspace/frontend && pnpm install && cd /workspace/backend && export PATH=/home/vscode/.local/bin:$PATH && uv sync --all-extras",
  "remoteUser": "vscode"
}
